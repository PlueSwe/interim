# Interim Radar -- exempelmiljo.
#
# Kopiera till .env och fyll i. .env ska aldrig checkas in.
#   cp .env.example .env
#
# De tre forsta varden maste satas. Allt ovrigt har en rimlig standard, och det
# som ar tomt ar tomt med flit: en halvifylld integration som tystnar ar varre
# an en som sager att den inte ar konfigurerad.


# =========================================================================
# Maste satas
# =========================================================================

# Losenord till Postgres. Anvands av bade db-containern och api/worker.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Nyckel for sessionsbiljetter. Byts den loggas alla ut, vilket ar meningen.
#   openssl rand -hex 32
SECRET_KEY=

# Nyckel for faltkryptering av personuppgifter (namn pa tillsatta chefer).
# Base64 av 32 slumpbytes, AES-256-GCM.
#   openssl rand -base64 32
# OBS: tappas nyckeln gar de krypterade falten inte att lasa igen. Ta en
# sakerhetskopia av den pa ett annat stalle an databasen.
FIELD_ENCRYPTION_KEY=


# =========================================================================
# Databas och ko
# =========================================================================

POSTGRES_USER=radar
POSTGRES_DB=interim_radar

# Satts av docker-compose.yml for containrarna. Raden nedan ar for nar du kor
# backend direkt pa maskinen.
# DATABASE_URL=postgresql+psycopg://radar:losenord@localhost:5432/interim_radar
# REDIS_URL=redis://localhost:6379/0

DB_ECHO=false


# =========================================================================
# Webb och sakerhet
# =========================================================================

ENVIRONMENT=prod
DEBUG=false

# Adressen anvandaren oppnar. Maste stamma exakt, inklusive protokoll och port,
# annars avvisas inloggningen av CSRF-kontrollen med "otillaten origin".
CORS_ORIGINS=["https://radar.exempel.se"]

# Vilken adress web-containern lyssnar pa. 127.0.0.1 betyder att bara en
# omvand proxy pa samma maskin kommer at den, vilket ar det du vill med TLS
# terminerat i Caddy eller nginx. 0.0.0.0 exponerar den direkt.
WEB_BIND=127.0.0.1

# false bara nar du kor utan TLS lokalt. I drift ska den vara true, annars
# skickas sessionscookien over http.
COOKIE_SECURE=true

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
LOGIN_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_MINUTES=15
API_RATE_LIMIT=120/minute


# =========================================================================
# Insamling
# =========================================================================

# Skickas med i varje utgaende anrop. Byt ut kontaktuppgiften mot en riktig --
# en myndighet som undrar vem som lasar ska kunna hora av sig, och en anonym
# skrapa ar inte ett bra satt att bygga fortroende.
USER_AGENT=InterimRadar/0.1 (privat bevakning av offentliga chefsrekryteringar; kontakt: din@adress.se)

HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3

# Minsta tid mellan anrop mot samma vard. HTML-sidor far langre paus an API:er
# eftersom de kostar mer for den som star for servern. Sank dem inte.
DELAY_API_SECONDS=0.5
DELAY_HTML_SECONDS=5.0

SNAPSHOT_DIR=data/snapshots


# =========================================================================
# AI (valfritt)
# =========================================================================

# none ar standard och ett fullgott lage: exkluderingsfiltret och
# poangsattningen ar regelstyrda och behover ingen modell. AI:n ger bara en
# andra bedomning av tvetydiga annonser, och den kan bara skarpa utfallet.
AI_PROVIDER=none

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Lokal OpenAI-kompatibel server, for nar underlaget inte far lamna huset.
# LOCAL_LLM_BASE_URL=http://localhost:11434
# LOCAL_LLM_MODEL=llama3.1:8b

AI_MAX_TOKENS=2048


# =========================================================================
# Avisering (valfritt)
# =========================================================================

# Lamnas SMTP tomt skrivs aviseringarna bara i databasen och visas i
# granssnittet. Ingenting skickas, och det star i gransnittet att det inte gor det.
NOTIFY_MATCH_THRESHOLD=80
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_FROM=radar@exempel.se
# NOTIFY_TO=din@adress.se


# =========================================================================
# Personuppgifter
# =========================================================================

# Hur lange namnet pa en tillsatt chef sparas efter beslutsdatum. Motiverat i
# SECURITY.md. Sankt varde raderar aldre uppgifter vid nasta nattliga korning.
PERSON_RETENTION_YEARS=5
